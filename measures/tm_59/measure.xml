  <class_name>TM59Report</class_name>
  <display_name>CIBSE TM59 Overheating Metrics</display_name>
  <description>Reports selected zone overheating metrics for TM59:2017 (A and B) or TM59:2026 (A, B, C and D without fan uplift).</description>
  <modeler_description>Use one annual EnergyPlus run. In the room fields, copy each zone name from the Thermal Zones tab, or use type= followed by a Space Type name to select matching zones. Assign each assessed zone to one group based on its use and modeled ventilation.</modeler_description>
  <arguments>
    <argument>
      <name>tm59_edition</name>
      <display_name>TM59 edition</display_name>
      <description>Select the methodology to report.</description>
      <type>Choice</type>
      <required>true</required>
      <model_dependent>false</model_dependent>
      <default_value>2017</default_value>
      <choices>
        <choice>
          <value>2017</value>
          <display_name>2017</display_name>
        </choice>
        <choice>
          <value>2026</value>
          <display_name>2026</display_name>
        </choice>
      </choices>
    </argument>
    <argument>
      <name>bs_en_15251_category</name>
      <display_name>Adaptive comfort category</display_name>
      <description>Use II for typical occupants or I for vulnerable occupants.</description>
      <type>Choice</type>
      <required>true</required>
      <model_dependent>false</model_dependent>
      <default_value>II</default_value>
      <choices>
        <choice>
          <value>I</value>
          <display_name>I</display_name>
        </choice>
        <choice>
          <value>II</value>
          <display_name>II</display_name>
        </choice>
      </choices>
    </argument>
    <argument>
      <name>living_kitchen_zones</name>
      <display_name>Naturally ventilated living rooms, kitchens and home offices</display_name>
      <description>Criterion A. Example: Living Room, Kitchen. Home offices apply in 2026. Enter names from Thermal Zones separated by commas. Quote names that contain commas. Use type= to select by Space Type. Leave empty if unused.</description>
      <type>String</type>
      <required>false</required>
      <model_dependent>false</model_dependent>
    </argument>
    <argument>
      <name>bedroom_zones</name>
      <display_name>Naturally ventilated bedrooms</display_name>
      <description>Criteria A and B. Example: Bedroom 1, Bedroom 2. Enter names from Thermal Zones separated by commas. Quote names that contain commas. Use type= to select by Space Type. Leave empty if unused.</description>
      <type>String</type>
      <required>false</required>
      <model_dependent>false</model_dependent>
    </argument>
    <argument>
      <name>living_kitchen_mechanical_zones</name>
      <display_name>Mechanical or cooled living rooms, kitchens and home offices (2026)</display_name>
      <description>Criterion C. Example: Cooled Lounge. Enter names from Thermal Zones separated by commas. Quote names that contain commas. Use type= to select by Space Type. Leave empty if unused.</description>
      <type>String</type>
      <required>false</required>
      <model_dependent>false</model_dependent>
    </argument>
    <argument>
      <name>bedroom_mechanical_zones</name>
      <display_name>Mechanical or cooled bedrooms (2026)</display_name>
      <description>Criteria B and C. Example: type=Mechanical Bedrooms. Enter names from Thermal Zones separated by commas. Quote names that contain commas. Use type= to select by Space Type. Leave empty if unused.</description>
      <type>String</type>
      <required>false</required>
      <model_dependent>false</model_dependent>
    </argument>
    <argument>
      <name>communal_zones</name>
      <display_name>Shared corridors, stairs and lobbies (2026)</display_name>
      <description>Criterion D. Example: Shared Corridor. Enter names from Thermal Zones separated by commas. Quote names that contain commas. Use type= to select by Space Type. Leave empty if unused.</description>
      <type>String</type>
      <required>false</required>
      <model_dependent>false</model_dependent>
    </argument>
    <argument>
      <name>tm59_2026_clock</name>
      <display_name>2026 summer clock</display_name>
      <description>Choose Local if the simulation clock already represents local summer time. Choose GMT for UK weather on GMT to shift assessment times one hour forward.</description>
      <type>Choice</type>
      <required>true</required>
      <model_dependent>false</model_dependent>
      <default_value>Local</default_value>
      <choices>
        <choice>
          <value>Local</value>
          <display_name>Local</display_name>
        </choice>
        <choice>
          <value>GMT</value>
          <display_name>GMT</display_name>
        </choice>
      </choices>
    </argument>
    <argument>
      <name>zone_types</name>
      <display_name>Existing JSON room map (optional)</display_name>
      <description>For saved workflows that already use a JSON room map. Leave all room fields empty when using this input.</description>
      <type>String</type>
      <required>false</required>
      <model_dependent>false</model_dependent>
    </argument>
  </arguments>
